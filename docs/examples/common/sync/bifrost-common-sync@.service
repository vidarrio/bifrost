# Apply a common game's allowlist over RCON: bifrost-common-sync@vanilla
# reads /etc/bifrost-common-sync/vanilla.env.
[Unit]
Description=Sync %i's allowlist from Bifrost over RCON
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/bifrost-common-sync/%i.env
Environment=STATE_DIR=/var/lib/bifrost-common-sync/%i
ExecStart=/usr/local/bin/bifrost-common-sync rcon
DynamicUser=yes
StateDirectory=bifrost-common-sync/%i
# Only the network and its own state; widen ReadWritePaths for SEED_DIR.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
