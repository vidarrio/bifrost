#!/usr/bin/env python3
"""Keep a common game's server in step with Bifrost, through its read-only
export (Settings -> Common-game export). Standard library only.

    bifrost-common-sync rcon   # apply the allowlist over Minecraft's RCON
    bifrost-common-sync copy   # write the allowlist and seed files to disk

Both read their settings from the environment (see bifrost-common-sync.env):

    BIFROST_URL          https://bifrost.example
    BIFROST_EXPORT_TOKEN the export token
    COMMON_KEY           the setup this server runs, e.g. vanilla.26.2
    SEASON               the season's id, if more than one live season has it
    SEED_DIR             where to put the slot's seed files when they change
                         (optional; for Minecraft, the .apmc)
    STATE_DIR            where to remember what was last done
                         (default /var/lib/bifrost-common-sync)
    AFTER                a shell command to run after anything changed
                         (optional; e.g. restarting the server)

rcon also takes RCON_HOST (default 127.0.0.1), RCON_PORT (25575),
RCON_PASSWORD, and KEEP: names never to remove (comma-separated, e.g. ops
who aren't playing). copy takes ALLOWLIST_FILE and ALLOWLIST_FORMAT: txt (one
name a line), json (an array of names) or minecraft (a whitelist.json, with
UUIDs looked up from Mojang and remembered in STATE_DIR).

Exit status: 0 when in step (whether or not anything changed), 1 on an
error, 2 on bad settings.
"""
import json
import os
import socket
import struct
import subprocess
import sys
import tempfile
import urllib.parse
import urllib.request


def env(name, default=None, required=False):
    v = os.environ.get(name, default)
    if required and not v:
        sys.exit(f"bifrost-common-sync: set {name}")
    return v


def log(msg):
    print(msg, flush=True)


def fetch(path, raw=False):
    req = urllib.request.Request(env("BIFROST_URL", required=True).rstrip("/") + path,
                                 headers={"Authorization": "Bearer " + env("BIFROST_EXPORT_TOKEN", required=True)})
    with urllib.request.urlopen(req, timeout=60) as r:
        body = r.read()
    return body if raw else json.loads(body)


def write_atomic(path, data):
    d = os.path.dirname(os.path.abspath(path))
    os.makedirs(d, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=d, prefix=".bifrost-sync-")
    try:
        with os.fdopen(fd, "wb") as f:
            f.write(data)
        os.chmod(tmp, 0o644)
        os.replace(tmp, path)
    except BaseException:
        os.unlink(tmp)
        raise


def common():
    """The live common game this server runs, from the export's index."""
    key, season = env("COMMON_KEY", required=True), env("SEASON")
    found = [(s, c) for s in fetch("/export/commons")["seasons"] for c in s["commons"]
             if c["key"] == key and (not season or s["id"] == season)]
    if not found:
        log(f"no live season has {key}: nothing to do")
        sys.exit(0)
    if len(found) > 1:
        sys.exit(f"bifrost-common-sync: {len(found)} live seasons have {key}: set SEASON to one of "
                 + ", ".join(s["id"] for s, _ in found))
    return found[0]


def allowlist(c):
    if not c["allowlist"]:
        sys.exit(f"bifrost-common-sync: {c['key']} doesn't take names, so it has no allowlist")
    return fetch(c["allowlist"]["url"] + "?format=json")


class State:
    """What was last done, so a run only acts on changes."""

    def __init__(self):
        self.dir = env("STATE_DIR", "/var/lib/bifrost-common-sync")
        os.makedirs(self.dir, exist_ok=True)

    def get(self, name, default=None):
        try:
            with open(os.path.join(self.dir, name)) as f:
                return json.load(f)
        except FileNotFoundError:
            return default

    def put(self, name, value):
        write_atomic(os.path.join(self.dir, name), json.dumps(value).encode())


def sync_seed(season, c, state):
    """Fetch the slot's seed files into SEED_DIR when the season's seed changes."""
    out = env("SEED_DIR")
    if not out:
        return False
    if state.get("seed") == season["seed"]:
        return False
    for f in c["files"]:
        write_atomic(os.path.join(out, f["filename"]), fetch(f["url"], raw=True))
        log(f"seed {season['seed']}: wrote {f['filename']}")
    state.put("seed", season["seed"])
    return True


def after(changed):
    cmd = env("AFTER")
    if changed and cmd:
        log(f"running: {cmd}")
        subprocess.run(cmd, shell=True, check=True)


# --- RCON (https://minecraft.wiki/w/RCON) ----------------------------------

class Rcon:
    def __init__(self, host, port, password):
        self.s = socket.create_connection((host, port), timeout=10)
        self.n = 0
        if self.send(3, password)[0] == -1:
            sys.exit("bifrost-common-sync: RCON refused the password")

    def send(self, kind, body):
        self.n += 1
        data = struct.pack("<ii", self.n, kind) + body.encode() + b"\0\0"
        self.s.sendall(struct.pack("<i", len(data)) + data)
        (length,) = struct.unpack("<i", self.recv(4))
        rid, _ = struct.unpack("<ii", self.recv(8))
        return rid, self.recv(length - 8)[:-2].decode(errors="replace")

    def recv(self, n):
        b = b""
        while len(b) < n:
            chunk = self.s.recv(n - len(b))
            if not chunk:
                raise ConnectionError("RCON connection closed")
            b += chunk
        return b

    def command(self, cmd):
        return self.send(2, cmd)[1]


def whitelisted(rcon):
    """Names on the server's whitelist, from `whitelist list`:
    "There are 2 whitelisted player(s): Alex, Steve"."""
    reply = rcon.command("whitelist list")
    _, _, names = reply.partition(":")
    return {n.strip() for n in names.split(",") if n.strip()}


def run_rcon():
    season, c = common()
    state = State()
    changed = sync_seed(season, c, state)
    want = set(allowlist(c))
    keep = {k.strip().lower() for k in env("KEEP", "").split(",") if k.strip()}
    rcon = Rcon(env("RCON_HOST", "127.0.0.1"), int(env("RCON_PORT", "25575")), env("RCON_PASSWORD", required=True))
    have = whitelisted(rcon)
    lower = {n.lower() for n in have}
    for name in sorted(want):
        if name.lower() not in lower:
            log(rcon.command(f"whitelist add {name}"))
            changed = True
    wanted = {n.lower() for n in want}
    for name in sorted(have):
        if name.lower() not in wanted and name.lower() not in keep:
            log(rcon.command(f"whitelist remove {name}"))
            changed = True
    after(changed)


# --- copy ------------------------------------------------------------------

def mojang_uuid(name, cache):
    if name.lower() in cache:
        return cache[name.lower()]
    url = "https://api.mojang.com/users/profiles/minecraft/" + urllib.parse.quote(name)
    try:
        with urllib.request.urlopen(url, timeout=20) as r:
            raw = json.loads(r.read())["id"]
    except Exception as e:
        log(f"couldn't look up {name}'s UUID ({e}); left out for now")
        return None
    uuid = f"{raw[:8]}-{raw[8:12]}-{raw[12:16]}-{raw[16:20]}-{raw[20:]}"
    cache[name.lower()] = uuid
    return uuid


def run_copy():
    season, c = common()
    state = State()
    changed = sync_seed(season, c, state)
    path = env("ALLOWLIST_FILE")
    if path:
        names = allowlist(c)
        fmt = env("ALLOWLIST_FORMAT", "txt")
        if fmt == "txt":
            data = "".join(n + "\n" for n in names).encode()
        elif fmt == "json":
            data = json.dumps(names).encode()
        elif fmt == "minecraft":
            cache = state.get("uuids", {})
            entries = [{"uuid": u, "name": n} for n in names if (u := mojang_uuid(n, cache))]
            state.put("uuids", cache)
            data = json.dumps(entries, indent=2).encode()
        else:
            sys.exit(f"bifrost-common-sync: ALLOWLIST_FORMAT is txt, json or minecraft, not {fmt}")
        try:
            with open(path, "rb") as f:
                same = f.read() == data
        except FileNotFoundError:
            same = False
        if not same:
            write_atomic(path, data)
            log(f"wrote {path} ({len(names)} names)")
            changed = True
    after(changed)


def main():
    mode = sys.argv[1] if len(sys.argv) == 2 else ""
    if mode not in ("rcon", "copy"):
        print(__doc__, file=sys.stderr)
        sys.exit(2)
    try:
        (run_rcon if mode == "rcon" else run_copy)()
    except (OSError, ValueError, subprocess.CalledProcessError) as e:
        sys.exit(f"bifrost-common-sync: {e}")


if __name__ == "__main__":
    main()
