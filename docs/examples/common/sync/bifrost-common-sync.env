# /etc/bifrost-common-sync/vanilla.env: settings for one common game's server.
# Holds the export token, so keep it to root: chmod 600.
BIFROST_URL=https://bifrost.example
BIFROST_EXPORT_TOKEN=
COMMON_KEY=vanilla.26.2
# SEASON=           # only if two live seasons both have this common game

# Where the slot's seed file goes when a season is (re)generated: for the
# Minecraft randomizer, the server's APData folder.
# SEED_DIR=/srv/minecraft/APData

# rcon mode (bifrost-common-sync@.service runs it):
RCON_HOST=127.0.0.1
RCON_PORT=25575
RCON_PASSWORD=
# KEEP=YourOpName   # whitelisted names it never removes

# copy mode (bifrost-common-copy@.service runs it):
# ALLOWLIST_FILE=/srv/minecraft/whitelist.json
# ALLOWLIST_FORMAT=minecraft   # txt, json or minecraft
# AFTER=systemctl restart minecraft.service
