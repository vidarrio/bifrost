From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: vidarrio <15656046+vidarrio@users.noreply.github.com>
Date: Tue, 3 Nov 2026 01:23:11 +0100
Subject: [PATCH 2/2] MultiServer: Bifrost's own clients don't change a slot's
 status

A slot's status said "connected" whenever one of Bifrost's tools was on
it, and Bifrost's board tracker, which never leaves, kept a slot's status
from clearing when its player left. A quiet client now neither sets nor
clears the status on joining or leaving, and an empty slot means no client
but quiet ones. Its Connected says so ("bifrost_status"), so Bifrost knows
it can trust the status of the slot its tracker is on.
---
 MultiServer.py | 6 ++++--
 1 file changed, 4 insertions(+), 2 deletions(-)

diff --git a/MultiServer.py b/MultiServer.py
index e6535523..8d83b060 100644
--- a/MultiServer.py
+++ b/MultiServer.py
@@ -1055,7 +1055,7 @@ def is_quiet_key(key: typing.Any) -> bool:
 
 
 async def on_client_joined(ctx: Context, client: Client):
-    if ctx.client_game_state[client.team, client.slot] == ClientStatus.CLIENT_UNKNOWN:
+    if not client.quiet and ctx.client_game_state[client.team, client.slot] == ClientStatus.CLIENT_UNKNOWN:
         update_client_status(ctx, client, ClientStatus.CLIENT_CONNECTED)
     version_str = '.'.join(str(x) for x in client.version)
 
@@ -1085,7 +1085,7 @@ async def on_client_joined(ctx: Context, client: Client):
 
 
 async def on_client_left(ctx: Context, client: Client):
-    if len(ctx.clients[client.team][client.slot]) < 1:
+    if not client.quiet and all(other.quiet for other in ctx.clients[client.team][client.slot]):
         update_client_status(ctx, client, ClientStatus.CLIENT_UNKNOWN)
         ctx.client_connection_timers[client.team, client.slot] = datetime.datetime.now(datetime.timezone.utc)
 
@@ -2028,6 +2028,8 @@ async def process_client_cmd(ctx: Context, client: Client, args: dict):
                 "slot_info": ctx.slot_info,
                 "hint_points": get_slot_points(ctx, team, slot),
             }
+            if client.quiet:
+                connected_packet["bifrost_status"] = True
             reply = [connected_packet]
             start_inventory = get_start_inventory(ctx, slot, client.remote_start_inventory)
             items = get_received_items(ctx, client.team, client.slot, client.remote_items)
